# ============================================================================
# Red Ball Adventure — variables de entorno del backend
#
# Copia este archivo a `.env` (o exporta las variables en el shell / Docker).
# Todas tienen un valor por defecto sensato: sin `.env` el juego arranca igual.
# ============================================================================

# Puerto y dirección donde escucha la API (y sirve el frontend).
PORT=3000
HOST=0.0.0.0

# `production` activa caché de estáticos (1 h) y mensajes de error escuetos.
NODE_ENV=development

# Orígenes permitidos por CORS, separados por comas. `*` = cualquiera (dev).
# En producción: https://tudominio.com,https://www.tudominio.com
CORS_ORIGENES=*

# Carpeta del frontend que se sirve como estáticos (por defecto ./frontend).
# FRONTEND_DIR=./frontend

# Dónde se guarda la "base de datos" JSON y con qué nombre.
DATOS_DIR=backend/datos
DATOS_ARCHIVO=redball.json

# Tamaño máximo del cuerpo JSON de una petición.
LIMITE_CUERPO=64kb

# Peticiones por minuto y por IP sobre /api (0 = sin límite).
LIMITE_PETICIONES=60

# Cuántas filas devuelve como máximo el ranking.
LIMITE_RANKING=50
